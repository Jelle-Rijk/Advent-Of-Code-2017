<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.jellerijk.aoc</groupId>
  <artifactId>aoc2017</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  
  <properties>
  <!-- Written in Java 21 for Java 21 -->
  	<maven.compiler.source>21</maven.compiler.source>
  	<maven.compiler.target>21</maven.compiler.target>
  	
  	
  	<!-- this is a variable, it can be used in the rest of the file with ${propertyname}-->
  	<junit.version>5.12.2</junit.version>
  </properties>
  
  <!--put plugins in the build section-->
  <build>
  	<plugins>
  		<!-- plugin to build JAR files -->
  		<plugin>
  			<groupId>org.apache.maven.plugins</groupId>
  			<artifactId>maven-jar-plugin</artifactId>
  			<version>3.4.2</version>
  			<configuration>
  				<archive>
  					<!-- Sets the manifest so Java knows where the main class is -->
  					<manifest>
  						<addClasspath>true</addClasspath>
  						<classpathPrefix>lib/</classpathPrefix>
  						<mainClass>com.jellerijk.aoc.aoc2017.App</mainClass>
  					</manifest>
  				</archive>
  			</configuration>
  		</plugin>
  		
  		<plugin>
  			<groupId>org.openjfx</groupId>
  			<artifactId>javafx-maven-plugin</artifactId>
  			<version>0.0.8</version>
  			<configuration>
  				<mainClass>com.jellerijk.aoc.aoc2017.App</mainClass>
  			</configuration>
  		</plugin>
  		
  		
  	</plugins>
  </build>
  
  <!-- put used libraries in the dependencies section 
   finding libraries: search.maven.org
  -->
  <dependencies>
  
  <!-- JUNIT -->
  	<dependency>
  		<groupId>org.junit.platform</groupId>
  		<artifactId>junit-platform-launcher</artifactId>
  		<version>1.12.2</version>
  		<!-- this means the library will only be bundled with test versions -->
  		<scope>test</scope>
  	</dependency>
  	<dependency>
  		<groupId>org.junit.jupiter</groupId>
  		<artifactId>junit-jupiter-engine</artifactId>
  		<!-- property that was set in the properties section-->
  		<version>${junit.version}</version>
  		<scope>test</scope>
  	</dependency>
  	
  <!-- JavaFX -->
  
  
  </dependencies>
</project>